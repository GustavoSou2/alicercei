# Copiar para .env e preencher com valores reais/locais.
# A aplicação falha ao subir se qualquer uma destas faltar — ver
# src/config/env.validation.ts. Não há fallback hardcoded para nenhuma
# delas, propositalmente (ver AS-IS-api.md, achado de segredo hardcoded).

DATABASE_URL="postgresql://user:password@localhost:5432/alicercei?schema=public"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
ALLOWED_ORIGINS="http://localhost:4200"
PORT=3000
NODE_ENV=development
